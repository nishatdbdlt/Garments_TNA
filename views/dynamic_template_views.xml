<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dynamic_template_tree" model="ir.ui.view">
        <field name="name">dynamic.template.tree</field>
        <field name="model">dynamic.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_template_form" model="ir.ui.view">
        <field name="name">dynamic.template.form</field>
        <field name="model">dynamic.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dynamic_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">dynamic.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dynamic_template_root"
              name="Dynamic Templates"
              sequence="10"/>

    <menuitem id="menu_dynamic_template"
              name="Templates"
              parent="menu_dynamic_template_root"
              action="action_dynamic_template"
              sequence="10"/>
</odoo>
